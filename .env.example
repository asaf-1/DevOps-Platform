# Copy to .env (gitignored) and fill in. See PLAN.md section 8.4.

# Model provider for the agents: ollama (local, default) or anthropic.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:4b
# From the host. Pods inside kind use http://host.docker.internal:11434 (set in Helm values).
OLLAMA_BASE_URL=http://localhost:11434
# Only when MODEL_PROVIDER=anthropic. Create with a monthly spend cap first.
ANTHROPIC_API_KEY=

# Fine-grained GitHub token scoped to this repo: Contents RW, Pull requests RW, Metadata R.
# Lets the agent open PRs that trigger their own CI run (GITHUB_TOKEN would not).
PLATFORM_GITHUB_TOKEN=
GITHUB_REPO=asaf-1/DevOps-Platform

# 1 only when Asaf asked for a real AWS run in this session. Default is LocalStack.
REAL_AWS=0
