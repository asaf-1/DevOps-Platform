{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asaf-1/DevOps-Platform/platform/catalog/dynamodb-table/schema.json",
  "title": "dynamodb-table request inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "team", "cost_center", "hash_key"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$",
      "description": "Table name. Lowercase letters, digits and hyphens, 3 to 40 characters."
    },
    "team": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,30}$"
    },
    "cost_center": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,30}$"
    },
    "hash_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Partition key attribute name."
    },
    "hash_key_type": {
      "type": "string",
      "enum": ["S", "N"],
      "default": "S",
      "description": "Partition key type: S string, N number."
    },
    "range_key": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "default": null,
      "description": "Optional sort key attribute name."
    },
    "range_key_type": {
      "type": "string",
      "enum": ["S", "N"],
      "default": "S"
    },
    "size": {
      "type": "string",
      "enum": ["small", "medium", "large"],
      "default": "small",
      "description": "small: on-demand capacity. medium: provisioned 5 read / 5 write. large: provisioned 25 / 25."
    },
    "ttl_attribute": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "default": null,
      "description": "Optional attribute holding an expiry epoch; items past it are deleted."
    },
    "point_in_time_recovery": {
      "type": "boolean",
      "default": true
    }
  }
}
